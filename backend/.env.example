# ---------------------------------------------------------------------------
# SafeWalk backend configuration.
# Copy this file to ".env" and fill in the values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# ----- Server -----
PORT=4000
NODE_ENV=development
# Browser origin(s) allowed to call this API (CORS). Comma-separate several origins.
FRONTEND_URL=http://localhost:5173

# ----- Database (PostgreSQL) -----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/safewalk?schema=public

# ----- Authentication -----
# Long random string (>= 32 characters recommended). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used to turn phone numbers typed without "+" (e.g. 9876543210) into international format.
DEFAULT_COUNTRY_CODE=+91

# ----- E-mail alerts (emergency alerts) -----
# Optional at start-up. Without these the app still runs, but fall alerts are recorded with
# status "not_configured" and NO e-mail is sent. Fill in ONE of the two options.
#
# Option A - SMTP (simplest for running on your own computer).
# Gmail example: turn on 2-Step Verification, create an "App password" at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#
# Option B - Brevo HTTPS API (use this when deployed: Render's free plan blocks SMTP ports).
# Create a free account at https://www.brevo.com, verify a sender address and create an API key.
# When BREVO_API_KEY and EMAIL_FROM are both set, Brevo is used instead of SMTP.
BREVO_API_KEY=
#
# Sender shown on the alert. For SMTP it defaults to SMTP_USER. For Brevo it is REQUIRED and
# must be a sender address you verified in Brevo.
EMAIL_FROM=
EMAIL_FROM_NAME=SafeWalk Alerts

# ----- AI chatbot (SafeWalk Assistant) -----
# Any provider that offers an OpenAI-compatible "/chat/completions" API works
# (OpenAI, Groq, OpenRouter, Together, Google Gemini's OpenAI-compatible endpoint, a local Ollama, ...).
# Optional at start-up. Without these the assistant answers from the built-in knowledge base only
# and tells the user that the AI model is not configured.
AI_API_KEY=
AI_MODEL=
# Examples:  https://api.openai.com/v1   |   https://api.groq.com/openai/v1   |   https://openrouter.ai/api/v1
AI_API_BASE_URL=https://api.openai.com/v1
